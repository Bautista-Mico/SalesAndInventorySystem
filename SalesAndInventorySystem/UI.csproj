<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>SalesInventory.UI</RootNamespace>
		<AssemblyName>SalesInventory</AssemblyName>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Model\Model.csproj" />
		<ProjectReference Include="..\BusinessLogic\BusinessLogic.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="SalesInventory.Model" />
		<Using Include="SalesInventory.BusinessLogic.Repository" />
		<Using Include="SalesInventory.BusinessLogic.Controller" />
		<Using Include="System.Data" />
	</ItemGroup>

	<!-- The DB scripts are copied next to the .exe so the app can create/update the database on startup. -->
	<ItemGroup>
		<Content Include="..\DB\**\*.sql" Link="DB\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>